```gitignore
# Build artifacts
dist/
build/
*.o
*.obj
*.out

# Dependencies
node_modules/
.pnp/
.pnp.js

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled CSS/JS
*.min.js
*.min.css

# Compression artifacts
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```